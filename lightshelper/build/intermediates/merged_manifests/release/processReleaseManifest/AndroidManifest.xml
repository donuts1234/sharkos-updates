<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sharkos.lights"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="28" />

    <!-- Only apps signed with the SharkOS key (SharkOS itself) may send commands or hear the state. -->
    <permission
        android:name="com.sharkos.permission.LIGHTS"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.sharkos.permission.LIGHTS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:label="SharkOS Lights" >

        <!-- Holds the connection to the LED box; commands arrive from SharkOS as service intents -->
        <service
            android:name="com.sharkos.lights.LightsService"
            android:exported="true"
            android:permission="com.sharkos.permission.LIGHTS" />
        <!-- The wake-up search, in its own process like Sharkware's helper -->
        <service
            android:name="com.sharkos.lights.PrimeScanService"
            android:exported="false"
            android:process=":scan" />
        <!-- Asks for location once (Android needs it for Bluetooth searching), then closes -->
        <activity
            android:name="com.sharkos.lights.SetupActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="com.sharkos.permission.LIGHTS"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>