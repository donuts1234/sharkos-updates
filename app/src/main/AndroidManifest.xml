<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BYD vehicle API (android.hardware.bydauto devices), as mapped by Shark Hub on the Shark 6
         (SOC_260811_S). Nearly all are "normal" (granted at install); STATISTIC_COMMON is
         "dangerous", so MainActivity asks for it once. Only the devices SharkOS reads or sets. -->
    <uses-permission android:name="android.permission.BYDAUTO_AC_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_AC_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_AC_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_SETTING_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_SETTING_GET" />
    <!-- Seat heating/ventilation live on the setting device on the Shark 6 -->
    <uses-permission android:name="android.permission.BYDAUTO_SETTING_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_STATISTIC_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_STATISTIC_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_SPEED_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_SPEED_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_TYRE_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_TYRE_GET" />

    <!-- A launcher has to see every installed app (targetSdk >= 30 hides them otherwise), and the
         car backend has to find BYD's client APK. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".SharkOsApp"
        android:label="SharkOS"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.SharkOS"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- The launcher. HOME makes it choosable as the Home app; LAUNCHER keeps an icon in BYD's
             own app list so it can be opened even if the head unit won't let it be the default. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Now Playing: Android only shares media sessions with an app the user has given
             notification access. SharkOS reads the session only; it never reads notifications. -->
        <service
            android:name=".media.MediaListener"
            android:exported="true"
            android:label="SharkOS Now Playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
