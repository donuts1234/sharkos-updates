<?xml version="1.0" encoding="utf-8"?>
<!-- SharkOS mark: a swept fin cutting the waterline, with a fading wake. Within the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- the fin: convex leading edge, concave trailing edge, sharp swept tip -->
    <path android:pathData="M31,66 C37,53 50,37 76,28 C66,37 61,51 67,66 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="52" android:startY="28" android:endX="52" android:endY="66">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFD6E9FF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- highlight along the leading edge -->
    <path android:pathData="M36,61 C42,51 52,40 70,31"
        android:strokeColor="#66FFFFFF" android:strokeWidth="1.6" android:strokeLineCap="round" android:fillColor="#00000000" />
    <!-- waterline -->
    <path android:pathData="M26,67 C32,63.5 38,63.5 44,67 S56,70.5 62,67 S74,63.5 82,67"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="3.4" android:strokeLineCap="round" android:fillColor="#00000000" />
    <!-- wake, fading back -->
    <path android:pathData="M34,75 C40,72.5 46,72.5 52,75 S64,77.5 72,75"
        android:strokeColor="#80FFFFFF" android:strokeWidth="2.6" android:strokeLineCap="round" android:fillColor="#00000000" />
    <path android:pathData="M44,82 C48,80.5 52,80.5 56,82 S62,83.5 66,82"
        android:strokeColor="#40FFFFFF" android:strokeWidth="2.2" android:strokeLineCap="round" android:fillColor="#00000000" />
</vector>
